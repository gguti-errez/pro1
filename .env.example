# Copia este archivo como .env (o define las variables en tu hosting).
# No escribas contraseñas reales en archivos del repositorio.
# Opcional: si no defines APP_PASSWORD, al abrir la página por primera vez
# se te pedirá crear la contraseña de la cuenta "admin".
# APP_PASSWORD=
# Opcional: código que se exige para esa configuración inicial (evita que otra persona la haga primero)
# SETUP_CODE=
# MASTER_USER=admin
PORT=3000
DATA_DIR=./data
SESSION_MINUTES=60
# Supabase (datos y evidencias persistentes). La llave secreta SOLO va aquí/en Render, nunca en el repositorio.
# SUPABASE_URL=https://TU-PROYECTO.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_BUCKET=evidencias
